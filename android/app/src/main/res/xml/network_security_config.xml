<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (Tailscale Serve uses publicly trusted certificates). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
